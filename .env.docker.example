# ==============================================================================
# 42Voice Production Environment Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Subdomains Setup
DASHBOARD_DOMAIN=
API_DOMAIN=
WS_DOMAIN=

# Node & Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=
PORT=
RELOAD=false

# ==============================================================================
# Supabase PostgreSQL Configuration
# ==============================================================================
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGMAX_CONNECTIONS=20

# DB_SSL_MODE: auto | disable | require | verify-full
# auto = enforce verify-full when ENVIRONMENT is production (and on supabase.co)
# disable = no TLS (development only), require = encrypt but skip verification
DB_SSL_MODE=auto

DATABASE_URL=

# ==============================================================================
# Initial Seed Passwords (used once on first startup; set in production!)
# ==============================================================================
SEED_SUPER_ADMIN_PASSWORD=
SEED_FINANCE_ADMIN_PASSWORD=
SEED_RESELLER_PASSWORD=
SEED_CLIENT_PASSWORD=

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_PASSWORD=
REDIS_URL=

# ==============================================================================
# LiveKit SFU Credentials
# ==============================================================================
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-agent-42
LIVEKIT_SIP_PUBLIC_URI=

# ==============================================================================
# AI Provider API Keys (STT, LLM, TTS)
# ==============================================================================
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ==============================================================================
# AWS S3 Recordings Configuration
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
S3_BUCKET_PATH=recordings/

ENABLE_TRANSCRIPTS=true
TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_SUMMARY_ENABLED=true
ENABLE_RECORDING=true

# ==============================================================================
# Twilio Integration
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SIP_DOMAIN=

# ==============================================================================
# Authentication & JWT Secrets
# ==============================================================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================================================
# Calendly OAuth Integration Settings
# ==============================================================================
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
CALENDLY_ENCRYPTION_KEY=

# ==============================================================================
# Frontend Web App URL Configurations
# ==============================================================================
REACT_APP_BACKEND_URL=
REACT_APP_LIVEKIT_URL=
BACKEND_URL=
FRONTEND_URL=
