# ==============================================================================
# 42Voice Production Environment Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Subdomains Setup
DASHBOARD_DOMAIN=dashboard.42voice.com
API_DOMAIN=api.42voice.com
WS_DOMAIN=ws.42voice.com

# Node & Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ==============================================================================
# Supabase PostgreSQL Configuration
# ==============================================================================
PGHOST=aws-1-ap-southeast-2.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.zgglqdmxcyqsjzwhrybi
PGPASSWORD=your_supabase_password_here
PGDATABASE=postgres
PGMAX_CONNECTIONS=20

DATABASE_URL=postgresql://postgres.zgglqdmxcyqsjzwhrybi:your_supabase_password_here@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@redis:6379/0

# ==============================================================================
# LiveKit SFU Credentials
# ==============================================================================
LIVEKIT_URL=wss://ws.42voice.com
LIVEKIT_PUBLIC_URL=wss://ws.42voice.com
LIVEKIT_API_KEY=myapikey
LIVEKIT_API_SECRET=mysupersecret
LIVEKIT_AGENT_NAME=voice-agent-42

# ==============================================================================
# AI Provider API Keys (STT, LLM, TTS)
# ==============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_LANGUAGE=en
OPENAI_MODEL=gpt-4-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ==============================================================================
# AWS S3 Recordings Configuration
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-6
S3_BUCKET_NAME=42v-lk
S3_BUCKET_PATH=recordings/

ENABLE_TRANSCRIPTS=true
TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_SUMMARY_ENABLED=true
ENABLE_RECORDING=true

# ==============================================================================
# Twilio Integration
# ==============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SIP_DOMAIN=42voice.pstn.sydney.twilio.com

# ==============================================================================
# Authentication & JWT Secrets
# ==============================================================================
JWT_ACCESS_SECRET=dev_access_secret_key_987654321_abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dev_refresh_secret_key_123456789_zyxwvutsrqponmlkjihgfedcba
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================================================================
# Calendly OAuth Integration Settings
# ==============================================================================
CALENDLY_CLIENT_ID=your_calendly_client_id_here
CALENDLY_CLIENT_SECRET=your_calendly_client_secret_here
CALENDLY_REDIRECT_URI=https://api.42voice.com/api/v1/integrations/calendly/callback
CALENDLY_ENCRYPTION_KEY=g4m8J6X9oD26oi5d_3fFmZtY4L86xHnK7aJ9oB5sC3A=

# ==============================================================================
# Frontend Web App URL Configurations
# ==============================================================================
REACT_APP_BACKEND_URL=https://api.42voice.com/api/v1
REACT_APP_LIVEKIT_URL=wss://ws.42voice.com
BACKEND_URL=https://api.42voice.com/api/v1
