# API Keys
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LiveKit Configuration - Remote Server
LIVEKIT_URL=wss://ws.42voice.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Twilio SIP Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+64xxxxxxxx
TWILIO_SIP_TRUNK_ID=TKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Only if using SIP authentication
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# AI Model Configuration
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024

# Sarvam Configuration
SARVAM_STT_MODEL=saarika:v1
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_TTS_LANGUAGE=hi-IN

# Session Configuration
SESSION_TIMEOUT=3600
MAX_CONVERSATION_HISTORY=20

# Logging
LOG_LEVEL=INFO
