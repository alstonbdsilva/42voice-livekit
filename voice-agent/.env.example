# ============================================
# API KEYS (Required)
# ============================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# ============================================
# LIVEKIT CONFIGURATION
# ============================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=inbound-agent

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=
PORT=
RELOAD=false
LOG_LEVEL=INFO

# ============================================
# DEEPGRAM STT CONFIGURATION
# ============================================
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_TIMEOUT=3600
MAX_CONVERSATION_HISTORY=20

# ============================================
# AWS S3 CONFIGURATION (Required for recordings/transcripts)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
S3_BUCKET_PATH=recordings/

# ============================================
# TRANSCRIPT CONFIGURATION
# ============================================
ENABLE_TRANSCRIPTS=true
TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_SUMMARY_ENABLED=true
ENABLE_RECORDING=true

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=

# ============================================
# TWILIO SIP CONFIGURATION (Optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TRUNK_ID=
TWILIO_SIP_DOMAIN=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGMAX_CONNECTIONS=20

# DB_SSL_MODE: auto | disable | require | verify-full
# auto enforces verify-full for production and supabase.co hosts
DB_SSL_MODE=auto

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# ============================================
# INTERNAL WORKER AUTHENTICATION
# ============================================
# Shared secret used by the trusted voice-agent worker (agent.py) to
# authenticate machine-to-machine calls such as POST /conversations/register
# (Authorization: Bearer <this value>). REQUIRED in production (server fails
# to boot without it) - set a long random value and keep it out of source control.
INTERNAL_WORKER_TOKEN=

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_SALT_ROUNDS=12

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# SMTP CONFIGURATION (Optional)
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
# BACKEND & FRONTEND CONFIGURATION
# ============================================
BACKEND_URL=
FRONTEND_URL=

# ============================================
# AGENT CONFIGURATION
# ============================================
AGENT_NAMES=Cascade Ava,Northwind Kai,Sterling Kai,Atlas Echo,PulsePoint Mira,Cascade Echo,Halcyon Leo,Sterling Mira,Atlas Kai,Bluemoon Ava,PulsePoint Ava,PulsePoint Nova,Vertex Mira,Bluemoon Echo

# ============================================
# FALLBACK MEDIA CONFIGURATION (Optional)
# ============================================
FALLBACK_AUDIO_URL=
