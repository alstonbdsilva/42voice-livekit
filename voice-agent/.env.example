# ============================================
# API KEYS (Required)
# ============================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# ============================================
# LIVEKIT CONFIGURATION
# ============================================
LIVEKIT_URL=wss://ws.42voice.com
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# ============================================
# DEEPGRAM STT CONFIGURATION
# ============================================
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US

# ============================================
# SARVAM AI CONFIGURATION
# ============================================
SARVAM_STT_MODEL=saarika:v1
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_STT_LANGUAGE=en-IN

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_TIMEOUT=3600
MAX_CONVERSATION_HISTORY=20

# ============================================
# AWS S3 CONFIGURATION (Required for recordings/transcripts)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your_s3_bucket_name_here
S3_BUCKET_PATH=recordings/

# ============================================
# TRANSCRIPT CONFIGURATION
# ============================================
ENABLE_TRANSCRIPTS=true
TRANSCRIPT_LANGUAGE=en
TRANSCRIPT_SUMMARY_ENABLED=true
ENABLE_RECORDING=true

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# TWILIO SIP CONFIGURATION (Optional)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SIP_TRUNK_ID=your_twilio_sip_trunk_id_here
TWILIO_SIP_DOMAIN=your_sip_domain.twilio.com
TWILIO_SIP_USERNAME=your_sip_username_here
TWILIO_SIP_PASSWORD=your_sip_password_here

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
PGHOST=your_postgres_host_here
PGPORT=5432
PGDATABASE=your_database_name_here
PGUSER=your_postgres_user_here
PGPASSWORD=your_postgres_password_here
PGMAX_CONNECTIONS=20

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_SALT_ROUNDS=12

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# SMTP CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@42voice.com

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_URL=http://localhost:5000/api/v1

# ============================================
# AGENT CONFIGURATION
# ============================================
AGENT_NAMES=Cascade Ava,Northwind Kai,Sterling Kai,Atlas Echo,PulsePoint Mira,Cascade Echo,Halcyon Leo,Sterling Mira,Atlas Kai,Bluemoon Ava,PulsePoint Ava,PulsePoint Nova,Vertex Mira,Bluemoon Echo

# ============================================
# FALLBACK MEDIA CONFIGURATION
# ============================================
FALLBACK_AUDIO_URL=https://www.w3schools.com/html/horse.mp3
