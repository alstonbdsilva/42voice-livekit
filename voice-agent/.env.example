OPENAI_MAX_TOKENS=1024

# Session Configuration
SESSION_TIMEOUT=3600
MAX_CONVERSATION_HISTORY=20

# Logging
LOG_LEVEL=INFO

# AWS S3 Configuration for Recording
AWS_ACCESS_KEY_ID=AKIAXN6O2OQ2DXJDLMX7
AWS_SECRET_ACCESS_KEY=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
AWS_REGION=ap-southeast-6
