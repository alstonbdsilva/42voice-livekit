# ==============================================================================
# 42Voice Local Development Environment Template
# Copy this file to .env before running: docker compose -f docker-compose.local.yml up -d
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000

# Redis Configuration
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@redis:6379/0

# LiveKit SFU Credentials (matches livekit.local.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=myapikey
LIVEKIT_API_SECRET=mysupersecret
LIVEKIT_AGENT_NAME=voice-agent-42

# AI Provider API Keys (Fill in your actual keys)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_LANGUAGE=en
OPENAI_MODEL=gpt-4-turbo

# Frontend and Backend URLs for Local Execution
REACT_APP_BACKEND_URL=http://localhost:8000/api/v1
REACT_APP_LIVEKIT_URL=ws://localhost:7880
BACKEND_URL=http://localhost:8000/api/v1

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=dev_access_secret_key_987654321_abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=dev_refresh_secret_key_123456789_zyxwvutsrqponmlkjihgfedcba
JWT_REFRESH_EXPIRY=7d
