# ==============================================================================
# 42Voice Local Development Environment Template
# Copy this file to .env before running: docker compose -f docker-compose.local.yml up -d
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG
HOST=
PORT=

# Redis Configuration
REDIS_PASSWORD=
REDIS_URL=

# LiveKit SFU Credentials
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-agent-42
LIVEKIT_SIP_PUBLIC_URI=

# DB_SSL_MODE: auto | disable | require | verify-full
# auto enforces verify-full for production and supabase.co hosts
DB_SSL_MODE=auto

# AI Provider API Keys (Fill in your actual keys)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en-US
OPENAI_MODEL=

# Frontend and Backend URLs
REACT_APP_BACKEND_URL=
REACT_APP_LIVEKIT_URL=
BACKEND_URL=
FRONTEND_URL=

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
